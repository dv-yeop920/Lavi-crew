# Supabase project URL and publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin used for Auth email callbacks. Include protocol, without a path.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Used by admin bootstrap and the notification processor; never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only bearer secret for POST /api/internal/notifications/process. Use at least 32 random characters.
CRON_SECRET=

# VAPID keys for Web Push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Browser-side public key for push subscription registration.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional processor tuning. Database-enforced ranges: batch 1-5, lease 60-300 seconds.
# Lease must exceed provider timeout by more than the 45-second execution safety margin.
NOTIFICATION_BATCH_SIZE=5
NOTIFICATION_LEASE_SECONDS=60

# One-time bootstrap input. Set temporarily on the server, run the documented bootstrap step, then remove.
LAVI_ADMIN_EMAIL=

# One-time crew seed inputs for `npm run seed:crew`. Set to 1 and a temporary password, run once, then remove.
LAVI_ALLOW_CREW_SEED=
LAVI_CREW_SEED_PASSWORD=

# Target month (YYYY-MM) for `npm run seed:crew-applications`. Its application period must be open.
LAVI_SEED_APPLICATION_MONTH=
