# Supabase project URL and publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only by the documented admin bootstrap script; never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Kakao Alimtalk adapter credentials. Missing values cause a recorded, safe failed delivery.
KAKAO_ALIMTALK_API_URL=
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=

# One-time bootstrap input. Set temporarily on the server, run the documented bootstrap step, then remove.
LAVI_ADMIN_EMAIL=
