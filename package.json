{
  "name": "lavi-crew",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:harness": "node scripts/check-harness.mjs",
    "db:reset": "supabase db reset --local --no-seed",
    "db:start": "supabase start --exclude realtime,storage-api,imgproxy,studio,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed:crew": "node --env-file=.env.local scripts/seed-crew-members.mjs",
    "seed:crew-applications": "node --env-file=.env.local scripts/seed-crew-applications.mjs",
    "seed:crew-assignments": "node --env-file=.env.local scripts/seed-crew-assignments.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:db": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f supabase/tests/mvp_e2e.sql",
    "test:e2e": "node scripts/run-browser-e2e.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "prettier": "3.9.5",
    "supabase": "2.111.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
